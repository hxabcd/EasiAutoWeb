{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easiauto-web",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".output/public",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
